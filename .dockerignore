# Everything the image does not need, and one thing it must never have.

# Secrets. .gitignore does not apply to docker builds, and app/.env would
# otherwise end up baked into an image layer, readable by anyone who pulls it.
.env
.env.*
**/.env

# Virtualenv and caches - 268 MB of them, and none of it is portable anyway.
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local Postgres data directory, owned by uid 999 and unreadable here.
pgdata/

# Local logs. The container writes its own.
logs/
app/logs/

# Not needed at runtime.
.git/
.gitignore
.idea/
tests/
docs/
*.md
