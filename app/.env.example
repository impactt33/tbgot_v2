# Copy this file and fill it in. Two places want it, and they want it filled
# differently:
#
#   local run   ->  app/.env       (settings reads it directly)
#   deployment  ->  .env           (next to docker-compose.yml)
#
# The deployment copy is read twice by compose: once to substitute ${DB_USER}
# and friends into the compose file itself, once to hand the whole set to the
# bot's environment. Only a .env in the project root does the first job.

# Telegram Bot
BOT_TOKEN=

# Gemini
GEMINI_API_KEY=

# WebSearch
SERPER_API_KEY=

# Postgres
# In compose these two change: DB_HOST is the service name rather than
# localhost, and DB_PORT is the container's own 5432 rather than the 5430
# published to the host. Copying this file verbatim onto a server is the usual
# way to get "connection refused" out of a deployment that is otherwise fine.
#   local:   DB_HOST=localhost  DB_PORT=5430
#   compose: DB_HOST=postgres   DB_PORT=5432
DB_HOST=localhost
DB_PORT=5430
DB_USER=postgres_user
DB_PASSWORD=
DB_NAME=

# Off in production. The default is True, and it logs every statement including
# post payloads - together with DEBUG-level logging that fills the 30 MB the
# log driver keeps within hours.
DATABASE_ECHO=true

#Redis
#   local:   REDIS_HOST=localhost
#   compose: REDIS_HOST=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Any zoneinfo name. Validated at startup - a wrong one fails the import.
USER_TIMEZONE=Europe/Moscow
